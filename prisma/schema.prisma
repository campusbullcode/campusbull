generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  role         Role          @default(STUDENT)
  targetYear   Int?
  branch       String?
  category     String?
  domicile     String?
  isPro        Boolean       @default(false)
  streak       Int           @default(0)
  testsTaken   Int           @default(0)
  avgScore     Float         @default(0)
  bestRank     Int?
  ugOrPg       String?
  address      String?
  rankUpdates  Int           @default(0)
  lastActiveAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  attempts     TestAttempt[]
  questions    Question[]
  answers      Answer[]
}

model Question {
  id        String   @id @default(uuid())
  userId    String
  content   String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Answer[]
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String
  imageUrl    String?
  isActive    Boolean   @default(true)
  scheduledAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model MockTest {
  id         String        @id @default(uuid())
  title      String
  type       String        // Full Syllabus, Chapter, PYQ, Grand Test
  subjects   String[]
  questions  Int
  duration   Int           // minutes
  difficulty String
  tag        String?
  avgScore   Float         @default(0)
  attempts   Int           @default(0)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  results    TestAttempt[]
}

model TestAttempt {
  id         String   @id @default(uuid())
  userId     String
  testId     String
  score      Float
  totalMarks Int
  timeTaken  Int      // seconds
  answers    Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test       MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model QuestionPaper {
  id          String          @id @default(uuid())
  slug        String          @unique          // e.g. "neet-2026"
  title       String                           // e.g. "NEET (UG) 2026"
  year        String?
  pdfUrl      String?                          // e.g. "/papers/neet-2026.pdf"
  durationMin Int             @default(180)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  questions   PaperQuestion[]
}

model PaperQuestion {
  id            String        @id @default(uuid())
  paperId       String
  number        Int
  subject       String?
  imageUrl      String                         // e.g. "/questions/neet-2026/q001.png"
  correctOption Int?                           // 0..3 = A..D; null = ungraded (practice)
  paper         QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, number])
}

// One row per completed static-paper attempt (keyed by slug, not a DB paper row,
// so it also covers the mock papers that only exist as static manifests).
model PaperResult {
  id           String   @id @default(uuid())
  slug         String?
  userId       String?
  graded       Boolean  @default(false)
  scorePercent Float?                          // null for practice-mode (ungraded) papers
  createdAt    DateTime @default(now())

  @@index([slug])
  @@index([userId])
}

model College {
  id         String   @id @default(uuid())
  name       String
  state      String?
  type       String?   // e.g. "Government", "Private", "AIIMS"
  tier       String?  
  allotments CollegeAllotment[]

  @@unique([name, state])
}

model CollegeAllotment {
  id         String   @id @default(uuid())
  collegeId  String
  round      String?
  aiRank     Int?
  stateRank  Int?
  year       String?
  category   String?
  college    College  @relation(fields: [collegeId], references: [id])
}
