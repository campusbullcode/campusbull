# Dev-only overrides (loaded by Vite when running `npm run dev`).
# Leave VITE_API_URL empty so the frontend calls same-origin /api, which Vite
# proxies to the local backend (http://localhost:5000). This avoids the CORS
# failures you get when the dev server runs on a port other than 5173.
# Production builds ignore this file and use the deployment's VITE_API_URL.
VITE_API_URL=
